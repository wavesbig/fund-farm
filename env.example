# 通用大模型 OpenAPI / OpenAI 兼容接口配置（可选，也可直接在网页设置中图形化配置）
# 支持 DeepSeek / 硅基流动 / 阿里百炼 / OpenAI 官方 / 本地 Ollama 等任意兼容端点
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat

# 访问密码强行重置（可选，若忘记网页设置的密码可通过此环境变量直接登录重置）
# APP_PASSWORD=your_new_password

# GitHub 仓库配置（可选，用于页脚和帮助菜单的 Issues 跳转与版本更新检查）
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/wavesbig/fund-farm
# 例如最新 Release 检查接口：
# NEXT_PUBLIC_GITHUB_LATEST_RELEASE_URL=https://api.github.com/repos/wavesbig/fund-farm/releases/latest

# Sentry 配置（可选）
# 从 Sentry 项目设置中获取 DSN：https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
# Sentry 身份验证令牌，用于构建时上传 Source Maps
SENTRY_AUTH_TOKEN=

# 如果要用 Github Actions 部署，需要在 Github 项目 Settings → secrets and actions → Actions → 创建 Repository secrets
